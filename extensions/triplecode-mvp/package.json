{
  "name": "triplecode-mvp",
  "displayName": "TripleCode MVP",
  "publisher": "triplecode",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.143.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "triplecode.signIn",
        "title": "Войти в TripleCode"
      },
      {
        "command": "triplecode.account",
        "title": "TripleCode: Аккаунт"
      },
      {
        "command": "triplecode.welcome",
        "title": "TripleCode: Welcome"
      },
      {
        "command": "triplecode.agent",
        "title": "TripleCode: Open Agent"
      },
      {
        "command": "triplecode.focusAgent",
        "title": "Agents",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "triplecode.newChat",
        "title": "New chat",
        "icon": {
          "light": "media/imgPlus1.svg",
          "dark": "media/imgPlus1.svg"
        }
      },
      {
        "command": "triplecode.importFromVSCode",
        "title": "TripleCode: Import from VS Code"
      },
      {
        "command": "triplecode.importFromFile",
        "title": "TripleCode: Import Profile from File"
      },
      {
        "command": "triplecode.rollbackImport",
        "title": "TripleCode: Rollback Last Import"
      },
      {
        "command": "triplecode.designSystem",
        "title": "TripleCode: Design System"
      },
      {
        "command": "triplecode.checkHistory",
        "title": "TripleCode: Check History"
      },
      {
        "command": "triplecode.undoLastApply",
        "title": "TripleCode: Undo Last AI Apply"
      },
      {
        "command": "triplecode.setApiKey",
        "title": "TripleCode: Set API Key"
      },
      {
        "command": "triplecode.selectModel",
        "title": "TripleCode: Select Model"
      },
      {
        "command": "triplecode.setInlineApiKey",
        "title": "TripleCode: Set Inline API Key"
      }
    ],
    "configuration": {
      "title": "TripleCode",
      "properties": {
        "triplecode.checkCommand": {
          "type": "string",
          "default": "npm test",
          "description": "Command run by the agent “Run checks” action in the workspace root."
        },
        "triplecode.ai.provider": {
          "type": "string",
          "enum": [
            "auto",
            "ollama",
            "openrouter",
            "stub"
          ],
          "default": "auto",
          "description": "AI provider for the agent chat: auto (probe Ollama, fall back to stub), ollama (local Ollama server), openrouter (cloud via your own API key), stub (deterministic local responses)."
        },
        "triplecode.ai.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the Ollama server."
        },
        "triplecode.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model used for chat, plans and edits."
        },
        "triplecode.ai.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Timeout for an entire agent turn in milliseconds, including provider selection and context retrieval. Inline completions use a limit of at most 10 seconds."
        },
        "triplecode.ai.numCtx": {
          "type": "number",
          "default": 16384,
          "description": "Context window in tokens requested from the Ollama model. Larger windows allow more file content per request but use more memory."
        },
        "triplecode.ai.projectContext": {
          "type": "boolean",
          "default": true,
          "description": "Include a compact workspace file tree and project digest (package.json, README) in AI requests so the model can reason about the whole project, not only open files."
        },
        "triplecode.ai.projectSearch": {
          "type": "boolean",
          "default": true,
          "description": "Lexically search the workspace for Ask-mode requests and include excerpts of the most relevant files in the model context."
        },
        "triplecode.ai.openrouterEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "OpenAI-compatible endpoint for the OpenRouter provider."
        },
        "triplecode.ai.openrouterModel": {
          "type": "string",
          "default": "openai/gpt-4o-mini",
          "description": "OpenRouter model id used when the provider is openrouter."
        },
        "triplecode.ai.inlineEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show inline AI completions (ghost text) in supported editors. Uses the dedicated inline model settings below."
        },
        "triplecode.ai.inlineProvider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai"
          ],
          "default": "ollama",
          "description": "Backend for inline completions: ollama (local Ollama server) or openai (any OpenAI-compatible endpoint, e.g. a self-hosted completion model)."
        },
        "triplecode.ai.inlineEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Endpoint for inline completions: Ollama base URL, or an OpenAI-compatible base URL ending in /v1 when inlineProvider is openai."
        },
        "triplecode.ai.inlineModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model used for inline completions. For openai provider set the served model name."
        }
      }
    },
    "keybindings": [
      {
        "command": "triplecode.focusAgent",
        "key": "ctrl+alt+a",
        "mac": "cmd+ctrl+a",
        "when": "workbenchState != empty && !inQuickOpen"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "triplecode.agent",
          "when": "workbenchState != empty"
        },
        {
          "command": "triplecode.focusAgent",
          "when": "false"
        },
        {
          "command": "triplecode.newChat",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "triplecode.newChat",
          "when": "view == triplecode.agentView",
          "group": "navigation@1"
        }
      ]
    },
