  "devDependencies": {
    "@fontsource/inter": "^5.2.5",
    "@storybook/react-vite": "^10.6.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "^0.28.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "storybook": "^10.6.8",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:webview": "tsc --noEmit -p webview && esbuild webview/agent.tsx webview/import-preview.tsx webview/design-system.tsx webview/design-system/design-system-components.css --bundle --minify --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=media",
    "eval:ai": "node eval/run.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  }
}
